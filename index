
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#09251b">
  <meta name="description" content="TOP TIME BARBERSHOP — мужской стиль, точность и внимание к деталям. Записывайтесь к мастеру в Ташкенте.">
  <title>TOP TIME BARBERSHOP | Твой стиль. Твоё время.</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --green: #09251b;
      --green2: #103b2b;
      --green3: #174b36;
      --gold: #d8b45b;
      --gold2: #f4dfa0;
      --cream: #f6efdf;
      --muted: #b5b5a6;
      --dark: #06170f;
      --line: rgba(216,180,91,.25);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; scroll-padding-top: 85px; }

    body {
      background: var(--green);
      color: var(--cream);
      font-family: 'Manrope', sans-serif;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: -1;
      opacity: .12;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.17'/%3E%3C/svg%3E");
    }

    a { color: inherit; text-decoration: none; }
    button { font: inherit; }
    img { max-width: 100%; display: block; }

    .container { width: min(1160px, 90%); margin: auto; }

    .gold { color: var(--gold); }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--gold);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 4px;
      text-transform: uppercase;
    }

    .eyebrow::before, .eyebrow::after {
      content: "";
      width: 23px;
      height: 1px;
      background: var(--gold);
    }

    h1, h2, h3 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
    }

    h2 {
      font-size: clamp(42px, 6vw, 68px);
      line-height: 1.05;
      margin-top: 18px;
    }

    .section-intro {
      color: var(--muted);
      line-height: 1.9;
      max-width: 560px;
      margin: 20px auto 0;
      font-size: 14px;
    }

    .section-heading { text-align: center; margin-bottom: 55px; }

    /* NAVIGATION */

    header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: rgba(6, 23, 15, .86);
      border-bottom: 1px solid rgba(216,180,91,.14);
      backdrop-filter: blur(18px);
      transition: .3s;
    }

    .nav {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 190px;
    }

    .brand img {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--gold);
    }

    .brand-text {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 2px;
    }

    .brand-text small {
      display: block;
      color: var(--gold);
      font-size: 9px;
      letter-spacing: 3px;
      margin-top: 4px;
    }

    .nav-links { display: flex; align-items: center; gap: 27px; }

    .nav-links a {
      font-size: 11px;
      color: #ddd9ca;
      transition: color .25s;
    }

    .nav-links a:hover { color: var(--gold2); }

    .nav-cta {
      border: 1px solid var(--gold);
      color: var(--gold2);
      padding: 12px 17px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1px;
      transition: .3s;
    }

    .nav-cta:hover {
      color: var(--dark);
      background: var(--gold);
      box-shadow: 0 0 25px #d8b45b30;
    }

    .menu-toggle {
      display: none;
      background: none;
      border: 1px solid var(--line);
      color: var(--gold);
      padding: 9px 12px;
      cursor: pointer;
    }

    /* HERO */

    .hero {
      min-height: 100svh;
      padding: 140px 0 80px;
      position: relative;
      display: flex;
      align-items: center;
      overflow: hidden;
      background:
        radial-gradient(ellipse at 80% 45%, #1b4a303f 0%, transparent 45%),
        linear-gradient(120deg, #06170f 0%, #0a291d 58%, #06170f 100%);
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 550px;
      height: 550px;
      border: 1px solid #d8b45b13;
      border-radius: 50%;
      right: -140px;
      top: 50%;
      transform: translateY(-50%);
      box-shadow: 0 0 0 40px #d8b45b08, 0 0 0 80px #d8b45b05;
    }

    .hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      align-items: center;
      gap: 50px;
    }

    .hero h1 {
      font-size: clamp(68px, 9.3vw, 122px);
      line-height: .85;
      letter-spacing: -3px;
      margin: 30px 0;
    }

    .hero h1 span {
      display: block;
      color: var(--gold);
      font-style: italic;
    }

    .hero-copy {
      color: #c6c8ba;
      max-width: 440px;
      font-size: 14px;
      line-height: 2;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 35px;
    }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      padding: 17px 25px;
      min-height: 53px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      border: 1px solid transparent;
      cursor: pointer;
      transition: transform .3s, box-shadow .3s, background .3s, color .3s;
    }

    .btn:hover { transform: translateY(-4px); }

    .btn-gold {
      color: #152317;
      background: linear-gradient(120deg, #c7a04a, #f2dda0, #c7a04a);
      background-size: 200% 100%;
      animation: goldFlow 5s ease infinite;
      box-shadow: 0 7px 28px #d8b45b20;
    }

    .btn-gold:hover {
      box-shadow: 0 10px 35px #d8b45b45;
    }

    .btn-outline {
      border-color: var(--line);
      color: var(--gold2);
      background: #ffffff03;
    }

    .btn-outline:hover {
      border-color: var(--gold);
      background: #d8b45b12;
    }

    @keyframes goldFlow {
      0%, 100% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
    }

    .hero-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      min-height: 430px;
    }

    .logo-frame {
      width: min(100%, 410px);
      aspect-ratio: 1;
      border-radius: 50%;
      border: 1px solid #d8b45b68;
      padding: 16px;
      position: relative;
      animation: reveal 1.1s ease both;
    }

    .logo-frame::before {
      content: "";
      position: absolute;
      inset: 7px;
      border: 1px solid #d8b45b38;
      border-radius: 50%;
    }

    .logo-frame img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #d8b45b;
      box-shadow: 0 0 70px #d8b45b20;
    }

    .orbit {
      position: absolute;
      width: 105%;
      height: 105%;
      border: 1px dashed #d8b45b38;
      border-radius: 50%;
      animation: spin 50s linear infinite;
    }

    .orbit::after {
      content: "✦";
      color: var(--gold);
      position: absolute;
      top: 10%;
      right: 17%;
      font-size: 22px;
    }

    .hero-stamp {
      position: absolute;
      right: -5px;
      bottom: 18px;
      padding: 17px 20px;
      background: #0a2c1e;
      border: 1px solid var(--gold);
      text-align: center;
    }

    .hero-stamp strong {
      display: block;
      font-family: 'Cormorant Garamond', serif;
      font-size: 28px;
      color: var(--gold);
    }

    .hero-stamp small {
      font-size: 9px;
      letter-spacing: 2px;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    @keyframes reveal {
      from { opacity: 0; transform: translateY(25px) scale(.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .hero-bottom {
      position: absolute;
      bottom: 25px;
      left: 5%;
      right: 5%;
      display: flex;
      justify-content: space-between;
      color: #b5b5a680;
      font-size: 9px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    /* MARQUEE */

    .marquee {
      overflow: hidden;
      background: var(--gold);
      color: var(--dark);
      padding: 17px 0;
      transform: rotate(-1deg) scale(1.02);
    }

    .marquee-track {
      display: flex;
      width: max-content;
      animation: marquee 30s linear infinite;
    }

    .marquee-track span {
      font-family: 'Cormorant Garamond', serif;
      font-size: 23px;
      font-weight: 700;
      letter-spacing: 3px;
      padding: 0 25px;
    }

    @keyframes marquee { to { transform: translateX(-50%); } }

    /* ABOUT */

    section { padding: 110px 0; }

    .about-grid {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 85px;
      align-items: center;
    }

    .about-emblem {
      min-height: 390px;
      background:
        radial-gradient(circle at center, #194b34 0%, #0a291d 48%, #06170f 75%);
      border: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      padding: 30px;
    }

    .about-emblem::before, .about-emblem::after {
      content: "";
      position: absolute;
      inset: 13px;
      border: 1px solid #d8b45b25;
      pointer-events: none;
    }

    .about-emblem::after { inset: 21px; }

    .emblem-symbol {
      font-size: 75px;
      color: var(--gold);
      line-height: 1;
      text-shadow: 0 0 35px #d8b45b25;
    }

    .about-emblem h3 {
      font-size: 34px;
      margin-top: 20px;
      color: var(--gold2);
    }

    .about-emblem p {
      font-size: 9px;
      letter-spacing: 4px;
      margin-top: 10px;
      color: var(--muted);
    }

    .about-copy h2 { margin-bottom: 25px; }

    .about-copy > p {
      color: var(--muted);
      line-height: 2;
      font-size: 14px;
      margin-bottom: 18px;
    }

    .feature-list { margin-top: 30px; display: grid; gap: 17px; }

    .feature {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }

    .feature-icon {
      color: var(--gold);
      border: 1px solid var(--line);
      min-width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
    }

    .feature strong { font-size: 12px; display: block; margin-bottom: 5px; }
    .feature p { font-size: 11px; color: var(--muted); line-height: 1.8; }

    /* SERVICES */

    .services { background: #061b12; }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .service-card {
      position: relative;
      padding: 35px 28px;
      border: 1px solid #d8b45b20;
      background: linear-gradient(145deg, #0e3022, #092016);
      transition: transform .35s, border-color .35s, box-shadow .35s;
      overflow: hidden;
    }

    .service-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      height: 2px;
      width: 0;
      background: var(--gold);
      transition: width .45s;
    }

    .service-card:hover {
      transform: translateY(-8px);
      border-color: #d8b45b80;
      box-shadow: 0 18px 45px #00000024;
    }

    .service-card:hover::before { width: 100%; }

    .service-number {
      color: #d8b45b60;
      font-family: 'Cormorant Garamond', serif;
      font-size: 38px;
    }

    .service-icon {
      font-size: 26px;
      margin: 20px 0;
      color: var(--gold);
    }

    .service-card h3 { font-size: 30px; margin-bottom: 12px; }

    .service-card p {
      font-size: 12px;
      line-height: 1.9;
      color: var(--muted);
      min-height: 45px;
    }

    .service-footer {
      border-top: 1px solid var(--line);
      padding-top: 20px;
      margin-top: 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }

    .service-footer span { font-size: 10px; color: var(--gold); }
    .service-footer a { font-size: 11px; font-weight: 800; }

    /* EXPERIENCE */

    .experience-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      border: 1px solid var(--line);
      background: var(--line);
      margin-top: 45px;
    }

    .experience-item {
      background: var(--green);
      text-align: center;
      padding: 40px 20px;
    }

    .experience-item strong {
      display: block;
      font-family: 'Cormorant Garamond', serif;
      color: var(--gold);
      font-size: 36px;
      margin-bottom: 9px;
    }

    .experience-item span {
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 1px;
    }

    /* CONTACT */

    .contact { background: #061b12; }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 65px;
      align-items: start;
    }

    .contact-copy h2 { margin-bottom: 20px; }

    .contact-copy > p {
      color: var(--muted);
      line-height: 2;
      font-size: 13px;
      margin-bottom: 35px;
    }

    .contact-list { display: grid; gap: 23px; }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 17px;
    }

    .contact-icon {
      width: 47px;
      height: 47px;
      display: grid;
      place-items: center;
      border: 1px solid var(--line);
      color: var(--gold);
      font-size: 19px;
      flex-shrink: 0;
    }

    .contact-item small {
      display: block;
      color: #999f90;
      font-size: 9px;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 7px;
    }

    .contact-item strong {
      font-size: 13px;
      font-weight: 600;
      overflow-wrap: anywhere;
    }

    .contact-item a:hover { color: var(--gold); }

    .contact-panel {
      padding: 35px;
      background: linear-gradient(145deg, #103624, #092016);
      border: 1px solid var(--line);
    }

    .contact-panel h3 { font-size: 35px; margin-bottom: 12px; }

    .contact-panel > p {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.9;
      margin-bottom: 25px;
    }

    .contact-buttons { display: grid; gap: 12px; }

    .contact-buttons .btn { width: 100%; }

    .map-links {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 14px;
    }

    .map-link {
      border: 1px solid var(--line);
      padding: 15px 10px;
      text-align: center;
      font-size: 10px;
      color: var(--gold2);
      transition: .3s;
    }

    .map-link:hover { background: #d8b45b12; border-color: var(--gold); }

    /* FOOTER */

    footer {
      padding: 35px 0;
      background: var(--dark);
      border-top: 1px solid var(--line);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 20px;
    }

    .footer-copy { color: #8b9689; font-size: 10px; line-height: 2; }

    .footer-socials { display: flex; gap: 20px; flex-wrap: wrap; }

    .footer-socials a {
      font-size: 11px;
      color: var(--gold);
      transition: opacity .2s;
    }

    .footer-socials a:hover { opacity: .65; }

    .back-top {
      position: fixed;
      bottom: 22px;
      right: 22px;
      z-index: 80;
      width: 43px;
      height: 43px;
      border: 1px solid var(--gold);
      background: #09251bf2;
      color: var(--gold);
      cursor: pointer;
      opacity: 0;
      visibility: hidden;
      transform: translateY(10px);
      transition: .3s;
    }

    .back-top.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    /* SCROLL ANIMATION */

    .reveal {
      opacity: 0;
      transform: translateY(25px);
      transition: opacity .8s ease, transform .8s ease;
    }

    .reveal.show { opacity: 1; transform: translateY(0); }

    .delay-1 { transition-delay: .1s; }
    .delay-2 { transition-delay: .2s; }

    /* RESPONSIVE */

    @media (max-width: 950px) {
      .nav-links { gap: 15px; }
      .nav-links a { font-size: 10px; }
      .nav-cta { display: none; }
      .hero-grid { gap: 25px; }
      .hero-visual { min-height: 330px; }
      .about-grid { gap: 40px; }
      .service-card { padding: 28px 20px; }
      .contact-grid { gap: 35px; }
    }

    @media (max-width: 720px) {
      .nav { min-height: 70px; }
      .brand img { width: 42px; height: 42px; }
      .brand-text { font-size: 11px; }
      .menu-toggle { display: block; }

      .nav-links {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        right: 0;
        padding: 25px 5%;
        background: #06170ff7;
        border-bottom: 1px solid var(--line);
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }

      .nav-links.open { display: flex; }

      .nav-links a {
        padding: 15px 0;
        border-bottom: 1px solid #d8b45b12;
        font-size: 12px;
      }

      .hero { padding: 120px 0 80px; min-height: auto; }
      .hero-grid { grid-template-columns: 1fr; gap: 25px; }
      .hero h1 { font-size: clamp(65px, 15vw, 100px); margin: 25px 0; }
      .hero-copy { font-size: 13px; }
      .hero-visual { min-height: 320px; margin: 10px 0 20px; }
      .logo-frame { width: min(78vw, 330px); }
      .hero-stamp { right: 0; bottom: 0; }
      .hero-bottom { font-size: 8px; letter-spacing: 1px; bottom: 18px; }

      section { padding: 80px 0; }
      .about-grid, .contact-grid { grid-template-columns: 1fr; gap: 40px; }
      .about-emblem { min-height: 310px; }
      .about-copy h2, h2 { font-size: 48px; }
      .section-heading { margin-bottom: 38px; }

      .service-grid { grid-template-columns: 1fr; gap: 15px; }
      .service-card { padding: 27px; }
      .service-card p { min-height: auto; }
      .experience-grid { grid-template-columns: 1fr; }
      .experience-item { padding: 25px; }
      .contact-panel { padding: 26px 22px; }
      .footer-inner { flex-direction: column; align-items: flex-start; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }

      .reveal { opacity: 1; transform: none; }
    }
  </style>
</head>

